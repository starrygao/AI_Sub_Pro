AISUB_ROOT=/vol1/1000/docker/ai-sub-pro
AISUB_DATA_DIR=/vol2/1000/docker/ai-sub-pro/data
AISUB_TEMP_DIR=/vol2/1000/docker/ai-sub-pro/tmp
AISUB_MODEL_DIR=/vol2/1000/docker/ai-sub-pro/models
AISUB_UID=1000
AISUB_GID=1000
AISUB_BIND=127.0.0.1
AISUB_PORT=18091
AISUB_PROXY=
AISUB_VTRANS_QUEUE=/vol1/1000/docker/vtrans/releases/queue-hdr-20260918/config/queue
# Required only by compose.nas.yaml: set to the actual media filesystem block device.
AISUB_MEDIA_DEVICE=/dev/mapper/REPLACE_ME
